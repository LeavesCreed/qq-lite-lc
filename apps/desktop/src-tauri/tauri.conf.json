{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QQ Lite LC",
  "version": "0.1.0",
  "identifier": "lc.leavescreed.qq-lite-lc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QQ Lite LC",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
